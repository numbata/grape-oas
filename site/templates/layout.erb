<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content="<%= h(description) %>">
  <meta name="theme-color" content="#673a79">
  <title><%= h(title) %> · grape-oas</title>
  <link rel="icon" href="<%= url('assets/favicon.svg') %>" type="image/svg+xml">
  <link rel="stylesheet" href="<%= url('assets/style.css') %>">
</head>
<body>
  <a class="skip-link" href="#main-content">Skip to content</a>
  <header class="site-header wrap">
    <a class="wordmark" href="<%= url %>" aria-label="grape-oas home"><span class="gem-mark" aria-hidden="true">◆</span> grape<span>-oas</span></a>
    <nav aria-label="Main navigation">
      <a href="<%= url('getting-started/') %>" <%= 'aria-current="page"' if page == 'guide' %>>Getting started</a>
      <a href="<%= url('benchmarks/') %>" <%= 'aria-current="page"' if page == 'benchmarks' %>>Benchmarks</a>
      <a href="<%= repo %>">GitHub <span aria-hidden="true">↗</span></a>
    </nav>
  </header>
  <main id="main-content"><%= @content %></main>
  <footer class="site-footer wrap">
    <p><strong>grape-oas</strong> <span>A Ruby gem. An open specification.</span></p>
    <div><a href="https://rubygems.org/gems/grape-oas">RubyGems</a><a href="<%= docs('CHANGELOG.md') %>">Changelog</a><a href="<%= docs('LICENSE.txt') %>">MIT license</a></div>
  </footer>
</body>
</html>
